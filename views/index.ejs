<script>
  /* ── Navigation ── */
  function show(id) {
    document.querySelectorAll('section').forEach(s => s.classList.remove('active'));
    const target = document.getElementById(id);
    if (target) target.classList.add('active');
    document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active-link'));
    const navKey = (id === 'meet-team') ? 'about' : id;
    const navEl = document.getElementById('nav-' + navKey);
    if (navEl) navEl.classList.add('active-link');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* ── Hash-based routing on page load ── */
  document.addEventListener('DOMContentLoaded', function () {
    const hash = location.hash.replace('#', '');
    const target = hash && document.getElementById(hash) ? hash : 'home';
    show(target);
    if (target === 'members') {
      /* re-show content if already unlocked in this session */
    }
  });

  /* ── Password gate ── */
  const MEMBER_PW = 'ewb2025';
  function checkPw() {
    const val = document.getElementById('pwInput').value;
    const err = document.getElementById('pwError');
    if (val === MEMBER_PW) {
      document.getElementById('pwGate').style.display = 'none';
      document.getElementById('membersContent').classList.add('visible');
      err.style.display = 'none';
    } else {
      err.style.display = 'block';
      document.getElementById('pwInput').value = '';
    }
  }

  /* ── Lightbox ── */
  function closeLb() {
    document.getElementById('lightbox').classList.remove('open');
  }
  document.getElementById('lightbox').addEventListener('click', function (e) {
    if (e.target === this) closeLb();
  });

  /* ── Toast ── */
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3000);
  }

  /* ── Newsletter ── */
  function submitNewsletter(e) {
    e.preventDefault();
    showToast("You're on the list!");
    e.target.reset();
  }
</script>

</body>
</html>
