<!-- ═══════════════════════════════════ ABOUT ══════════════════════════════════ -->
<section id="about">
  <div class="sec-label">Our Story</div>
  <h2 class="sec-title">Built to <em>empower</em></h2>
  <div class="divider"></div>

  <div class="about-two-col">
    <div class="about-text">
      <p>EWB — Empowering Women in Business — is a student-led club at Bergen County Academies committed to equipping young women with the skills, network, and confidence to thrive in the business world.</p>
      <p>We believe the next generation of leaders is already here. Through <mark>networking events</mark>, speaker panels, workshops, and our flagship annual conference, we connect students with professionals across finance, entrepreneurship, marketing, and consulting.</p>
      <p>Whether you're passionate about starting your own company, breaking into Wall Street, or reimagining what leadership looks like — EWB is your community.</p>

      <div class="stat-row">
        <div>
          <div class="stat-num">50+</div>
          <div class="stat-lbl">Members</div>
        </div>
        <div>
          <div class="stat-num">10+</div>
          <div class="stat-lbl">Events / Year</div>
        </div>
        <div>
          <div class="stat-num">3rd</div>
          <div class="stat-lbl">Year Running</div>
        </div>
      </div>

      <a class="meet-team-btn" onclick="show('meet-team')" href="javascript:void(0)">Meet the Team →</a>
    </div>

    <div class="contact-sidebar">
      <div class="contact-sidebar-title">Get in Touch</div>
      <a class="c-link" href="https://instagram.com/ewb.bca" target="_blank">
        <div>
          <div class="c-link-label">Instagram</div>
          @ewb.bca
        </div>
      </a>
      <a class="c-link" href="mailto:ewbbca@gmail.com">
        <div>
          <div class="c-link-label">Email</div>
          ewbbca@gmail.com
        </div>
      </a>
      <a class="c-link" onclick="show('conference')" href="javascript:void(0)">
