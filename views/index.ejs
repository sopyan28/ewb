<!-- ══════════════════════════════════ MEMBERS ════════════════════════════════ -->
<section id="members">

  <!-- Password Gate -->
  <div class="pw-gate" id="pwGate">
    <div class="pw-card">
      <div class="pw-lock">🔒</div>
      <h2>Members Area</h2>
      <p>Enter the club password to access member posts and announcements.</p>
      <div class="pw-row">
        <input type="password" id="pwInput" placeholder="• • • • • • • •"
               onkeydown="if(event.key==='Enter') checkPw()">
        <div class="pw-error" id="pwError">Incorrect password. Please try again.</div>
        <button class="btn-primary" onclick="checkPw()">Enter &nbsp;→</button>
      </div>
    </div>
  </div>

  <!-- Members Content (shown after correct password) -->
  <div class="members-content" id="membersContent">
    <div class="sec-label">Members Only</div>
    <h2 class="sec-title">Posts &amp; <em>Announcements</em></h2>
    <div class="divider"></div>

    <div class="members-notice">
      <p>Welcome to the EWB member portal. Post announcements, event recaps, or anything you'd like the club to know. All members can view, create, edit, and delete posts.</p>
    </div>

    <!-- Posts list from DB -->
    <div class="members-section">
      <h3>Recent Posts</h3>

      <% if (posts.length === 0) { %>
        <div class="empty-state">No posts yet. Be the first to share something!</div>
      <% } else { %>
        <% posts.forEach(function(post) { %>
          <div class="post-card">
            <div class="post-card-meta">
              <span class="category-badge"><%= post.category %></span>
              &nbsp;· &nbsp;<%= post.createdFormatted %> &nbsp;· &nbsp;by <%= post.author %>
            </div>
            <div class="post-card-title"><%= post.title %></div>
            <div class="post-card-content"><%= post.content %></div>
            <div class="post-card-actions">
              <a class="btn-ghost" href="/posts/<%= post.postId %>">View &amp; Edit →</a>
              <a class="btn-danger"
                 href="/posts/<%= post.postId %>/delete"
                 onclick="return confirm('Delete this post?')">Delete</a>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Create Post Form -->
    <div class="members-section">
      <h3>New Post</h3>
      <div class="post-form-card">
        <form method="post" action="/posts">
          <div class="form-group">
            <label for="newTitle">Title</label>
            <input type="text" id="newTitle" name="title" placeholder="Post title" required>
          </div>
          <div class="form-group">
            <label for="newCategory">Category</label>
            <select id="newCategory" name="category">
              <option value="Announcement">Announcement</option>
              <option value="Event">Event</option>
              <option value="Recap">Recap</option>
              <option value="Resource">Resource</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="newAuthor">Your Name</label>
            <input type="text" id="newAuthor" name="author" placeholder="Your name" required>
          </div>
          <div class="form-group">
            <label for="newContent">Content</label>
            <textarea id="newContent" name="content" placeholder="Write your post…" rows="5"></textarea>
          </div>
          <button type="submit" class="btn-primary">Post &nbsp;→</button>
        </form>
      </div>
    </div>
  </div>

</section>

